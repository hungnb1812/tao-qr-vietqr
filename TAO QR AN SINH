    function removeVietnameseTones(str) {
        if (!str) return "";
        str = str.replace(/à|á|ạ|ả|ã|â|ầ|ấ|ậ|ẩ|ẫ|ă|ằ|ắ|ặ|ẳ|ẵ/g, "a");
        str = str.replace(/è|é|ẹ|ẻ|ẽ|ê|ề|ế|ệ|ể|ễ/g, "e");
        str = str.replace(/ì|í|ị|ỉ|ĩ/g, "i");
        str = str.replace(/ò|ó|ọ|ỏ|õ|ô|ồ|ố|ộ|ổ|ỗ|ơ|ờ|ớ|ợ|ở|ỡ/g, "o");
        str = str.replace(/ù|ú|ụ|ủ|ũ|ư|ừ|ứ|ự|ử|ữ/g, "u");
        str = str.replace(/ỳ|ý|ỵ|ỷ|ỹ/g, "y");
        str = str.replace(/đ/g, "d");
        return str;
    }

    function docSoTien(soTien) {
        if (soTien === 0) return "Không đồng";
        const ChuSo = ["không", "một", "hai", "ba", "bốn", "năm", "sáu", "bảy", "tám", "chín"];
        const Tien = ["", "nghìn", "triệu", "tỷ"];

        function docBlock3So(num, isHighest) {
            let tram = Math.floor(num / 100);
            let chuc = Math.floor((num % 100) / 10);
            let donVi = num % 10;
            let str = "";
            if (tram > 0 || !isHighest) {
                str += ChuSo[tram] + " trăm ";
                if (chuc === 0 && donVi > 0) str += "lẻ ";
            }
            if (chuc > 1) {
                str += ChuSo[chuc] + " mươi ";
                if (donVi === 1) str += "mốt ";
                else if (donVi === 5) str += "lăm ";
                else if (donVi > 0) str += ChuSo[donVi] + " ";
            } else if (chuc === 1) {
                str += "mười ";
                if (donVi === 1) str += "một ";
                else if (donVi === 5) str += "lăm ";
                else if (donVi > 0) str += ChuSo[donVi] + " ";
            } else if (chuc === 0 && donVi > 0 && tram > 0) {
                if (donVi === 5) str += "lăm ";
                else str += ChuSo[donVi] + " ";
            }
            return str.trim();
        }

        let strSo = Math.abs(soTien).toString();
        let i = 0, kq = [];
        while (strSo.length > 0) {
            let len = strSo.length;
            let chunk = parseInt(strSo.substring(Math.max(0, len - 3), len), 10);
            strSo = strSo.substring(0, Math.max(0, len - 3));
            if (chunk > 0) {
                let blockStr = docBlock3So(chunk, strSo.length === 0);
                if (Tien[i]) blockStr += " " + Tien[i];
                kq.unshift(blockStr);
            }
            i++;
        }
        let finalStr = kq.join(" ").replace(/\s+/g, ' ').trim();
        return finalStr.charAt(0).toUpperCase() + finalStr.slice(1) + " đồng";
    }

    async function getBase64FromImageUrl(url) {
        return new Promise((resolve) => {
            let img = new Image();
            img.crossOrigin = "anonymous";
            img.onload = function () {
                let canvas = document.createElement("canvas");
                canvas.width = img.width; canvas.height = img.height;
                let ctx = canvas.getContext("2d");
                ctx.drawImage(img, 0, 0);
                resolve(canvas.toDataURL("image/png"));
            };
            img.onerror = function () { resolve(url); };
            img.src = url;
        });
    }

    document.getElementById('excelAnSinhFile').addEventListener('change', async function(e) {
        let file = e.target.files[0];
        if (!file) return;
        let reader = new FileReader();
        
        reader.onload = async function(e) {
            let workbook = XLSX.read(new Uint8Array(e.target.result), {type: 'array'});
            globalMembersData = [];
            let sheetsMap = new Map();

            let targetSheetName = workbook.SheetNames.find(s => s.toLowerCase() !== 'thamso') || workbook.SheetNames[0];
            let firstWs = workbook.Sheets[targetSheetName];
            let firstData = XLSX.utils.sheet_to_json(firstWs, {header: 1});

            let detectedDonVi = "QUỸ HỖ TRỢ PHỤ NỮ PHÁT TRIỂN TỈNH QUẢNG TRỊ";
            let selectElem = document.getElementById('selectPhongNghiepVu');
            let detectedChiNhanh = selectElem ? selectElem.options[selectElem.selectedIndex].text : "Phòng Nghiệp vụ số 01 (Lệ Thủy)";
            let detectedMauSo = "Mẫu số: 38/TD";

            for (let r = 0; r < Math.min(8, firstData.length); r++) {
                let row = firstData[r];
                if (!row) continue;
                row.forEach(cell => {
                    if (cell && typeof cell === 'string') {
                        let text = cell.trim();
                        let upper = text.toUpperCase();
                        
                        if (upper.includes("QUỸ HỖ TRỢ") || upper.includes("CHƯƠNG TRÌNH TÀI CHÍNH VI MÔ") || upper.includes("TÀI CHÍNH VI MÔ")) {
                            if (!upper.includes("PHÒNG") && !upper.includes("CHI NHÁNH")) {
                                detectedDonVi = text;
                            }
                        }
                        if (upper.includes("PHÒNG NGHIỆP VỤ") || upper.includes("CHI NHÁNH") || upper.includes("PHÒNG GD")) {
                            detectedChiNhanh = text;
                        }
                        if (upper.includes("MẪU SỐ")) {
                            detectedMauSo = text;
                        }
                        if (upper.includes("BẢNG KÊ")) {
                            dynamicReportTitle = text;
                        }
                    }
                });
            }

            workbook.SheetNames.forEach(sheetName => {
                if (sheetName.toLowerCase() === 'thamso') return;
                let ws = workbook.Sheets[sheetName];
                let sheetData = XLSX.utils.sheet_to_json(ws, {header: 1});
                let tenNhomSheet = sheetName.trim();

                let sheetXa = "Xã Lệ Thủy", sheetThon = "Thôn Hồng Thủy";
                let groupMemberMap = new Map();

                for (let i = 0; i < sheetData.length; i++) {
                    let row = sheetData[i];
                    if (!row) continue;
                    row.forEach(cell => {
                        if (cell && typeof cell === 'string') {
                            let text = cell.trim();
                            if (text.includes("Xã")) sheetXa = text.replace(/Xã\/Phường[:\s]*/gi, "").trim();
                            if (text.includes("Thôn") || text.includes("Cụm")) sheetThon = text.replace(/Thôn\/Bản\/TDP[:\s]*/gi, "").trim();
                        }
                    });

                    if (row[0] && !isNaN(row[0]) && row[2]) {
                        let stt = row[0];
                        let maTV = String(row[1] || '').trim();
                        let hoTen = String(row[2] || '').trim();
                        let soSo = String(row[3] || '').trim();
                        let soDu = parseFloat(row[4]) || 0;
                        let tongCong = parseFloat(row[5]) || parseFloat(row[10]) || 0;

                        if (groupMemberMap.has(maTV)) {
                            let existing = groupMemberMap.get(maTV);
                            existing.soDuTkbb += soDu;
                            existing.tongCong += tongCong;
                            if (soSo) {
                                existing.soSoList.push(soSo);
                                existing.soDuList.push(soDu);
                                existing.tongCongList.push(tongCong);
                            }
                        } else {
                            let memObj = {
                                sheetName: tenNhomSheet, sheetXa: sheetXa, sheetThon: sheetThon,
                                donVi: detectedDonVi, chiNhanh: detectedChiNhanh, mauSo: detectedMauSo,
                                stt: stt, maTV: maTV, hoTen: hoTen, soSo: soSo, soDuTkbb: soDu, tongCong: tongCong,
                                soSoList: [soSo], soDuList: [soDu], tongCongList: [tongCong]
                            };
                            groupMemberMap.set(maTV, memObj);
                        }
                    }
                }

                groupMemberMap.forEach((memObj) => {
                    globalMembersData.push(memObj);
                    if (!sheetsMap.has(tenNhomSheet)) sheetsMap.set(tenNhomSheet, []);
                    sheetsMap.get(tenNhomSheet).push(memObj);
                });
            });

            let selectGroupPDF = document.getElementById('selectGroupPDF');
            let optionsHtml = '<option value="ALL">-- Tất cả các nhóm trong file --</option>';
            sheetsMap.forEach((members, groupName) => {
                optionsHtml += `<option value="${groupName}">Nhóm: ${groupName}</option>`;
            });
            selectGroupPDF.innerHTML = optionsHtml;

            let bankId = document.getElementById('bankId').value.trim();
            let bankAcc = getSelectedBankAccount();
            let bankAccName = document.getElementById('bankAccName').value.trim();

            for (let mem of globalMembersData) {
                if (mem.tongCong > 0) {
                    let addInfoStr = `${mem.maTV} ${removeVietnameseTones(mem.hoTen)} nop tien`.trim();
                    let printUrl = `https://img.vietqr.io/image/${bankId}-${bankAcc}-print.png?amount=${mem.tongCong}&addInfo=${encodeURIComponent(addInfoStr)}&accountName=${encodeURIComponent(bankAccName)}`;
                    mem.qrBase64 = await getBase64FromImageUrl(printUrl);
                } else {
                    mem.qrBase64 = "";
                }
            }

            displayPreview(globalMembersData);
        };
        reader.readAsArrayBuffer(file);
    });

    function displayPreview(data) {
        let tbody = document.getElementById('previewBody');
        tbody.innerHTML = '';
        document.getElementById('rowCount').innerText = data.length;
        
        data.forEach((mem) => {
            let combinedSoSo = mem.soSoList ? mem.soSoList.join('<br>') : (mem.soSo || '-');
            let qrCellHtml = mem.tongCong > 0 ? `<img src="${mem.qrBase64}" class="thumb-qr" onclick="openModal('${mem.qrBase64}', '${mem.hoTen}')" title="Xem lớn">` : 'Không có';
            let tr = `<tr>
                <td class="text-center">${mem.stt}</td>
                <td style="font-weight: bold; color: #0275d8;">${mem.sheetName}</td>
                <td class="text-center">${mem.maTV}</td>
                <td>${mem.hoTen}</td>
                <td class="text-center"><strong>${combinedSoSo}</strong></td>
                <td class="text-right">${mem.soDuTkbb > 0 ? mem.soDuTkbb.toLocaleString('vi-VN') : '-'}</td>
                <td class="text-right" style="color: #d9534f; font-weight: bold;">${mem.tongCong > 0 ? mem.tongCong.toLocaleString('vi-VN') : '-'}</td>
                <td class="text-center">${qrCellHtml}</td>
            </tr>`;
            tbody.innerHTML += tr;
        });

        document.getElementById('preview-section').style.display = 'block';
    }

    function generatePrintPDF(targetGroup = null) {
        let selectedGroup = targetGroup || document.getElementById('selectGroupPDF').value;
        let bankAcc = getSelectedBankAccount();
        if(!bankAcc) { alert("Vui lòng chọn số tài khoản ngân hàng!"); return; }

        let rawDateVal = document.getElementById('inputNgayThu').value;
        let ngayThuFormatted = "Ngày ... tháng ... năm ......";
        if (rawDateVal) {
            let parts = rawDateVal.split('-');
            if (parts.length === 3) {
                ngayThuFormatted = `Ngày ${parts[2]} tháng ${parts[1]} năm ${parts[0]}`;
            }
        }

        let printArea = document.getElementById('printArea');
        printArea.innerHTML = '';

        if (selectedGroup && selectedGroup !== "ALL") {
            document.title = selectedGroup;
        } else {
            document.title = "TatCa_Cac_Nhom";
        }

        globalMembersData.forEach((mem) => {
            if (selectedGroup !== "ALL" && mem.sheetName !== selectedGroup) return;
            if (mem.tongCong <= 0) return;

            let docSo = docSoTien(mem.tongCong);
            let logoTag = logoBase64 ? `<img src="${logoBase64}" style="max-height: 48px; width: auto; object-fit: contain; margin-right: 12px; vertical-align: middle;">` : '';

            let rowsHtml = '';
            let listSoSo = mem.soSoList && mem.soSoList.length > 0 ? mem.soSoList : [mem.soSo];
            let listSoDu = mem.soDuList && mem.soDuList.length > 0 ? mem.soDuList : [mem.soDuTkbb];
            let listTong = mem.tongCongList && mem.tongCongList.length > 0 ? mem.tongCongList : [mem.tongCong];

            for (let idx = 0; idx < listSoSo.length; idx++) {
                rowsHtml += `
                    <tr>
                        <td class="text-center" style="font-weight: bold;">${listSoSo[idx] || '---'}</td>
                        <td class="text-right">${(listSoDu[idx] || 0).toLocaleString('vi-VN')}</td>
                        <td class="text-right" style="font-weight: bold;">${(listTong[idx] || 0).toLocaleString('vi-VN')}</td>
                    </tr>
                `;
            }

            rowsHtml += `
                <tr style="background-color: #f9f9f9; font-weight: bold;">
                    <td class="text-center">TỔNG CỘNG</td>
                    <td class="text-right">${mem.soDuTkbb.toLocaleString('vi-VN')}</td>
                    <td class="text-right" style="color: #d9534f; font-size: 12pt;">${mem.tongCong.toLocaleString('vi-VN')}</td>
                </tr>
            `;

            let formattedChiNhanh = mem.chiNhanh;
            if (formattedChiNhanh.includes("Phòng")) {
                formattedChiNhanh = formattedChiNhanh.replace("Phòng", "<br>Phòng");
            } else if (formattedChiNhanh.includes("_")) {
                formattedChiNhanh = formattedChiNhanh.replace("_", "<br>");
            }

            let htmlPhieu = `
                <div class="phieu-container">
                    <table style="width: 100%; border-collapse: collapse; margin-bottom: 5px;">
                        <tr>
                            <td style="width: 78%; text-align: left; vertical-align: middle;">
                                <div style="display: flex; align-items: center;">
                                    ${logoTag}
                                    <div>
                                        <div style="font-weight: bold; font-size: 10pt; line-height: 1.2;">${mem.donVi}</div>
                                        <div style="font-size: 9.5pt; line-height: 1.3; margin-top: 2px;">${formattedChiNhanh}</div>
                                    </div>
                                </div>
                            </td>
                            <td style="width: 22%; text-align: right; vertical-align: top; font-size: 10pt;">
                                <div>${mem.mauSo}</div>
                            </td>
                        </tr>
                    </table>
                    <div class="title-phieu">${dynamicReportTitle}</div>
                    <div class="sub-date">${ngayThuFormatted}</div>
                    <div class="diaban-row">
                        <strong>Xã:</strong> ${mem.sheetXa} &nbsp;&nbsp;&nbsp;&nbsp; 
                        <strong>Thôn:</strong> ${mem.sheetThon} &nbsp;&nbsp;&nbsp;&nbsp; 
                        <strong>Nhóm:</strong> ${mem.sheetName}
                    </div>
                    <div style="margin-bottom: 6px;">
                        <strong>Mã TV:</strong> ${mem.maTV} &nbsp;&nbsp;&nbsp;&nbsp; 
                        <strong>Họ tên:</strong> ${mem.hoTen}
                    </div>
                    
                    <table class="tbl-chitiet">
                        <tr>
                            <th style="width: 20%;">Số sổ</th>
                            <th style="width: 40%;">Số dư TKBB An Sinh</th>
                            <th style="width: 40%;">Số tiền nộp (Kế hoạch)</th>
                        </tr>
                        ${rowsHtml}
                    </table>

                    <div style="margin-bottom: 20px;"><strong>Số tiền bằng chữ:</strong> <i>${docSo}</i></div>
                    <div style="text-align: center;">
                        <div style="font-size: 10pt; font-weight: bold; margin-bottom: 4px;">MÃ QR CHUYỂN KHOẢN VIETQR (GỒM TẤT CẢ CÁC SỔ)</div>
                        <img src="${mem.qrBase64}" style="width: 220px; height: 250px; border: 1px solid #ccc; padding: 4px;">
                    </div>
                </div>
            `;
            printArea.innerHTML += htmlPhieu;
        });

        window.print();
    }

    function openModal(imgSrc, titleText) {
        document.getElementById('modalImg').src = imgSrc;
        document.getElementById('modalTitle').innerText = titleText;
        document.getElementById('imageModal').style.display = 'block';
    }
    function closeModal() { document.getElementById('imageModal').style.display = 'none'; }
    function renderFolderView() {
        let container = document.getElementById('qrCardsList');
        container.innerHTML = '';
        globalMembersData.forEach(mem => {
            if (mem.tongCong > 0 && mem.qrBase64) {
                let card = document.createElement('div');
                card.className = 'qr-card';
                card.innerHTML = `
                    <div style="font-weight: bold; font-size: 13px; color: #0275d8; margin-bottom: 3px;">${mem.hoTen}</div>
                    <div style="font-size: 11px; color: #666; margin-bottom: 5px;">Mã TV: ${mem.maTV} | ${mem.sheetName}</div>
                    <img src="${mem.qrBase64}" onclick="openModal('${mem.qrBase64}', '${mem.hoTen}')">
                    <div style="font-weight: bold; font-size: 12px; color: #d9534f; margin-top: 5px;">${mem.tongCong.toLocaleString('vi-VN')} VNĐ</div>
                `;
                container.appendChild(card);
            }
        });
        document.getElementById('folderViewContainer').style.display = 'block';
    }
    function sendZaloToGroupLeader() {
        let phone = document.getElementById('groupLeaderPhone').value.trim();
        if (!phone) { alert("Vui lòng nhập SĐT Zalo Nhóm trưởng!"); return; }
        window.open(`https://zalo.me/${phone.replace(/\D/g, '')}`, '_blank');
    }
</script>
