        .qr-card { display: inline-block; border: 1px solid #ddd; padding: 10px; margin: 8px; text-align: center; border-radius: 6px; background: #fff; width: 262px; vertical-align: top; box-shadow: 0 2px 5px rgba(0,0,0,0.05); box-sizing: border-box; }
        .qr-card img { width: 100%; height: 310px; border: 1px solid #eee; padding: 2px; object-fit: contain; background: #fff; cursor: pointer; }

        /* Modal Popup xem ảnh lớn */
        .modal { display: none; position: fixed; z-index: 1000; left: 0; top: 0; width: 100%; height: 100%; overflow: auto; background-color: rgba(0,0,0,0.8); text-align: center; }
